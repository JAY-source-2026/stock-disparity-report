# 토스증권 Open API (시세 조회 전용) — 실제 값은 .env 에 넣고 커밋하지 않는다.
# .env 는 .gitignore 에 포함되어 있다. 이 값들은 절대 로그/채팅/커밋에 노출하지 않는다.
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=

# (선택) KRX 확정 투자자별 수급용 — data.krx.co.kr 무료 계정. 미설정 시 네이버로 자동 폴백.
KRX_ID=
KRX_PW=

# (선택) FMP 경제캘린더(CPI·FOMC·금통위 등) — financialmodelingprep.com 무료 키. 미설정 시 기존 방식.
FMP_API_KEY=
